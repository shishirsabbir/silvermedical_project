{
  "name": "@silver-medical/storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build && opennextjs-cloudflare populateCache local",
